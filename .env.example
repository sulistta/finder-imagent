# Localhost Image Finder Environment Variables
# Copy this file to .env. API keys are loaded by the local backend only.

# Either a comma-separated list or numbered variables are supported.
GOOGLE_API_KEYS=
# GOOGLE_API_KEY_1=
# GOOGLE_API_KEY_2=

# Model names are intentionally configured, not hardcoded in server code.
GEMINI_QUERY_MODEL=
GEMINI_RANKING_MODEL=
GEMINI_VISUAL_MODEL=
GEMINI_METADATA_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Local server settings.
IMAGE_FINDER_PORT=5174
IMAGE_FINDER_DATA_DIR=.image-finder-data
GOOGLE_HEADLESS=false
GOOGLE_DELAY_MIN_MS=2000
GOOGLE_DELAY_MAX_MS=5000
GOOGLE_MAX_QUERIES=6
GOOGLE_MAX_CANDIDATES_PER_QUERY=5
