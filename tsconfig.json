{
	"compilerOptions": {
		"module": "Node16",
		"target": "ES2022",
		"lib": [
			"ES2022",
			"DOM"
		],
		"sourceMap": true,
		"rootDir": ".",
		"strict": true,
		"skipLibCheck": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"allowUnreachableCode": false,
		"noFallthroughCasesInSwitch": true
	},
	"include": [
		"server/src/env.ts",
		"server/src/gemini.ts",
		"server/src/google.ts",
		"server/src/httpServer.ts",
		"server/src/index.ts",
		"server/src/jobManager.ts",
		"server/src/pageAgentSelection.ts",
		"server/src/types.ts",
		"server/src/workbook.ts",
		"shared"
	],
	"exclude": [
		"node_modules",
		"webview-ui",
		"dist",
		"out",
		"scripts"
	]
}
